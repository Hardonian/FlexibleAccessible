# ─── Core ─────────────────────────────────────
NODE_ENV=development
# Canonical site URL for OG metadata, sitemap, and billing return URLs (optional; falls back to NEXTAUTH_URL / VERCEL_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Buyer-facing sales / managed services (mailto on marketing; optional)
# NEXT_PUBLIC_PRODUCT_CONTACT_EMAIL=sales@yourcompany.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aros?schema=public
REDIS_URL=redis://localhost:6379

# ─── Session ─────────────────────────────────
# Custom session system (aros_session cookie). No NextAuth.js.
# This value is used as cookie encryption salt if needed in future.
SESSION_SECRET=change-me-to-at-least-32-chars-long-secret

# ─── Enterprise SSO (OIDC) — optional ───────
# When set, /login shows “Continue with organization SSO”.
# See docs/SECURITY_ENTERPRISE_SSO_OIDC.md
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# OIDC_EMAIL_DOMAIN=yourcompany.com
# OIDC_JIT_SIGNUP=true
# OIDC_LINK_EXISTING_EMAIL=true

# ─── Stripe Billing ──────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_starter
STRIPE_PRICE_PROFESSIONAL=price_professional
STRIPE_PRICE_ENTERPRISE=price_enterprise

# ─── GitHub Integration ──────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Used by deploy-webhook signature verification
GITHUB_WEBHOOK_SECRET=

# ─── AI (for remediation suggestions) ────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── MCP Server (for IDE/service integrations) ──
# Set these when running @aros/mcp-server standalone
AROS_API_KEY=
AROS_API_URL=https://api.aros.dev

# ─── Transactional email (password reset + signup verification in production) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@yourcompany.com

# ─── Storage (for snapshots/artifacts) ────────
S3_BUCKET=aros-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Worker ──────────────────────────────────
WORKER_CONCURRENCY=3
MAX_CRAWL_PAGES=500

# ─── Deploy Webhooks (self-healing) ──────────
VERCEL_WEBHOOK_SECRET=
NETLIFY_WEBHOOK_SECRET=
CUSTOM_WEBHOOK_SECRET=

# ─── Turborepo (remote cache) ────────────────
TURBO_TOKEN=
TURBO_TEAM=
TURBO_REMOTE_CACHE_SIGNATURE_KEY=
