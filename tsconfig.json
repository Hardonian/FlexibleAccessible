{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@aros/shared": ["packages/shared/src"],
      "@aros/db": ["packages/db/src"],
      "@aros/config": ["packages/config/src"],
      "@aros/stakeholders": ["packages/stakeholders/src"],
      "@aros/ai-review": ["packages/ai-review/src"]
    },
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"],
    "declaration": true,
    "declarationMap": true
  },
  "files": [],
  "include": [],
  "references": [
    { "path": "apps/web" },
    { "path": "apps/worker" },
    { "path": "packages/agents" },
    { "path": "packages/ai-review" },
    { "path": "packages/cli" },
    { "path": "packages/clustering" },
    { "path": "packages/config" },
    { "path": "packages/core-services" },
    { "path": "packages/db" },
    { "path": "packages/integrations" },
    { "path": "packages/mcp-server" },
    { "path": "packages/rag" },
    { "path": "packages/remediation" },
    { "path": "packages/scan-engine" },
    { "path": "packages/shared" },
    { "path": "packages/stakeholders" },
    { "path": "packages/ui" }
  ],
  "exclude": ["node_modules", "dist"]
}
