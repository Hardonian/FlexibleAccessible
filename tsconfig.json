{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "."
  },
  "files": [],
  "references": [
    { "path": "./apps/web" },
    { "path": "./apps/worker" },
    { "path": "./packages/config" },
    { "path": "./packages/db" },
    { "path": "./packages/stakeholders" }
  ]
}




