name: AROS Accessibility Check

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

jobs:
  a11y-scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: ./.github/actions/aros-scan
        with:
          aros-url: ${{ vars.AROS_URL || 'https://aros.dev' }}
          api-key: ${{ secrets.AROS_SESSION_TOKEN }}
          organization-id: ${{ vars.AROS_ORG_ID }}
          site-id: ${{ vars.AROS_SITE_ID }}
          fail-on: critical
          comment-pr: "true"
