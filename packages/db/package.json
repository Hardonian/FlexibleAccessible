{
  "name": "@aros/db",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "npm install @prisma/client@7.7.0 --workspace=packages/db --no-save && prisma generate --schema=prisma/schema.prisma --config=prisma/prisma.config.ts",
    "push": "prisma db push --schema=prisma/schema.prisma --config=prisma/prisma.config.ts",
    "migrate": "prisma migrate dev --schema=prisma/schema.prisma --config=prisma/prisma.config.ts",
    "seed": "tsx prisma/seed.ts",
    "bootstrap": "tsx scripts/ensure-platform.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^7.7.0"
  },
  "devDependencies": {
    "@prisma/debug": "^7.6.0",
    "empathic": "^2.0.0",
    "exsolve": "^1.0.8",
    "prisma": "^7.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
