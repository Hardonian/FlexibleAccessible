generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH & TENANCY ──────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  /// Local password accounts only; null when the user signs in exclusively via OIDC (enterprise SSO).
  passwordHash   String?
  emailVerified  Boolean  @default(false)
  /// OIDC issuer URL (normalized, no trailing slash) when linked to an enterprise IdP.
  oidcIssuer     String?
  /// Stable subject (`sub`) from the IdP id_token.
  oidcSubject    String?

  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    Membership[]
  reviewTasks    ReviewTask[]    @relation("assignee")
  auditLogs      AuditLog[]
  sessions       Session[]
  findingStatusChanges CanonicalFinding[] @relation("findingStatusChangedBy")
  findingStatusEvents  FindingStatusEvent[]
  aiUsageLogs     AiUsageLog[]
  verificationRunsTriggered FindingVerificationRun[] @relation("verificationTriggeredBy")
  governanceDecisionsCreated FindingGovernanceDecision[] @relation("governanceCreatedBy")
  governanceDecisionsApproved FindingGovernanceDecision[] @relation("governanceApprovedBy")
  governanceDecisionsRevoked FindingGovernanceDecision[] @relation("governanceRevokedBy")
  findingComments FindingComment[]
  securityTokens SecurityToken[]
  createdVerifiedDomains OrganizationVerifiedDomain[] @relation("verifiedDomainCreatedBy")

  @@unique([oidcIssuer, oidcSubject], name: "users_oidc_issuer_subject_key")
  @@map("users")
}

enum SecurityTokenKind {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model SecurityToken {
  id         String            @id @default(cuid())
  userId     String
  kind       SecurityTokenKind
  tokenHash  String            @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
  @@map("security_tokens")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  workspaces        Workspace[]
  billingCustomer   BillingCustomer?
  subscription      Subscription?
  auditLogs         AuditLog[]
  aiUsageLogs       AiUsageLog[]
  integrationConnections IntegrationConnection[]
  apiKeys           ApiKey[]
  mcpUsageLogs      McpUsageLog[]
  remediationRecipes RemediationRecipe[]
  fixCredits         FixCredit[]
  fixCreditBalances  FixCreditBalance[]
  findingComments    FindingComment[]
  deployWebhooks     DeployWebhook[]
  authPolicy         OrganizationAuthPolicy?
  verifiedDomains    OrganizationVerifiedDomain[]

  // MCP API monetization
  mcpEnabled         Boolean  @default(false)
  mcpTokenLimit      Int      @default(0)
  mcpUsageThisPeriod Int      @default(0)

  @@map("organizations")
}

model OrganizationAuthPolicy {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  loginMode              AuthLoginMode @default(PASSWORD_AND_SSO)
  enforceVerifiedDomains Boolean  @default(false)
  allowJitProvisioning   Boolean  @default(false)
  ssoConfigStatus        OrgSsoConfigStatus @default(DISABLED)
  ssoIssuerUrl           String?
  ssoEntryPoint          String?
  ssoMetadataUrl         String?
  scimBaseUrl            String?
  scimTokenLastRotatedAt DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_auth_policies")
}

model OrganizationVerifiedDomain {
  id              String   @id @default(cuid())
  organizationId  String
  domain          String
  verifiedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("verifiedDomainCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, domain])
  @@index([organizationId, verifiedAt])
  @@index([createdByUserId])
  @@map("organization_verified_domains")
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sites        Site[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

enum MemberRole {
  OWNER
  ADMIN
  DEVELOPER
  CONTENT_EDITOR
  AUDITOR
  REVIEWER
}

enum AuthLoginMode {
  PASSWORD_AND_SSO
  SSO_ONLY
  PASSWORD_ONLY
}

enum OrgSsoConfigStatus {
  DISABLED
  INCOMPLETE
  CONFIGURED
}

model Membership {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole @default(DEVELOPER)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ─── SITES & CRAWLING ────────────────────────────────────────

enum SiteEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

model Site {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  domain      String
  environment SiteEnvironment @default(PRODUCTION)
  verified    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  crawlConfig  CrawlConfig?
  crawlRuns    CrawlRun[]
  pages        Page[]
  scanRuns     ScanRun[]
  issueClusters IssueCluster[]
  githubRepoMapping GitHubRepoMapping?
  canonicalFindings CanonicalFinding[]
  reports           Report[]
  evidenceRecords   FindingEvidence[]
  verificationRuns  FindingVerificationRun[]
  governanceDecisions FindingGovernanceDecision[]
  deployWebhooks    DeployWebhook[]
  aiVisualReviewRuns AiVisualReviewRun[]
  aiVisualFindings   AiVisualFinding[]


  @@index([workspaceId])
  @@map("sites")
}

model CrawlConfig {
  id                String   @id @default(cuid())
  siteId            String   @unique
  sitemapUrl        String?
  maxDepth          Int      @default(5)
  maxPages          Int      @default(500)
  includePatterns   String[] @default([])
  excludePatterns   String[] @default([])
  respectRobots     Boolean  @default(true)
  renderJavaScript  Boolean  @default(true)
  /** When true, worker enqueues a site scan after a crawl completes with pages. */
  autoScanAfterCrawl Boolean @default(true)
  viewports         Json     @default("[{\"width\":1280,\"height\":720},{\"width\":375,\"height\":812}]")
  scheduleCron      String?
  authConfig        Json?
  customHeaders     Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("crawl_configs")
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/** Outcome of attempting to start a verification scan after a crawl completes (worker-written). */
enum PostCrawlScanKickoffStatus {
  NOT_REQUESTED
  REQUESTED
  ENQUEUED
  SKIPPED_BY_SETTING
  QUEUE_UNAVAILABLE
  QUEUE_REJECTED
  DISPATCH_UNAVAILABLE
  KICKOFF_FAILED_UNKNOWN
}

/** Structured reason when a ScanRun never left the queue (enqueue-time failure). */
enum ScanEnqueueFailureCode {
  QUEUE_UNAVAILABLE
  QUEUE_REJECTED
  DISPATCH_UNAVAILABLE
  KICKOFF_FAILED_UNKNOWN
}

model CrawlRun {
  id            String      @id @default(cuid())
  siteId        String
  status        CrawlStatus @default(PENDING)
  pagesFound    Int         @default(0)
  pagesCrawled  Int         @default(0)
  pagesFailed   Int         @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?
  metadata      Json?
  /** Canonical post-crawl auto-scan attempt outcome (distinct from crawl success/failure). */
  postCrawlScanKickoffStatus      PostCrawlScanKickoffStatus @default(NOT_REQUESTED)
  postCrawlScanKickoffReasonCode  ScanEnqueueFailureCode?
  postCrawlScanKickoffDetail      String?
  postCrawlScanKickoffScanRunId   String?
  createdAt     DateTime    @default(now())

  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  scanRuns  ScanRun[]

  @@index([siteId])
  @@index([status])
  @@map("crawl_runs")
}

model Page {
  id            String   @id @default(cuid())
  siteId        String
  url           String
  path          String
  title         String?
  statusCode    Int?
  contentHash   String?
  lastCrawledAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site       Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  snapshots  PageSnapshot[]
  violations RawViolation[]
  findings   FindingOccurrence[]
  evidenceRecords FindingEvidence[]
  aiVisualFindings AiVisualFinding[]

  @@unique([siteId, url])
  @@index([siteId])
  @@map("pages")
}

model PageSnapshot {
  id            String   @id @default(cuid())
  pageId        String
  crawlRunId    String?
  domSnapshot   String?
  screenshotKey String?
  accessibilityTree Json?
  consoleErrors Json?
  networkErrors Json?
  viewport      Json?
  capturedAt    DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([crawlRunId])
  @@map("page_snapshots")
}

// ─── SCANNING & FINDINGS ─────────────────────────────────────

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ScanRun {
  id            String     @id @default(cuid())
  siteId        String
  crawlRunId    String?
  status        ScanStatus @default(PENDING)
  totalPages    Int        @default(0)
  pagesScanned  Int        @default(0)
  violationsFound Int      @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?
  /** Set when the run failed before a worker claimed it (e.g. BullMQ add failed). */
  enqueueFailureCode ScanEnqueueFailureCode?
  createdAt     DateTime   @default(now())

  site      Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlRun  CrawlRun?      @relation(fields: [crawlRunId], references: [id])
  violations RawViolation[]
  findingsLastVerified CanonicalFinding[]
  evidenceRecords FindingEvidence[]
  verificationRuns FindingVerificationRun[]
  visualReviewRuns AiVisualReviewRun[]

  @@index([siteId])
  @@index([crawlRunId])
  @@map("scan_runs")
}

enum Severity {
  CRITICAL
  SERIOUS
  MODERATE
  MINOR
}

model RawViolation {
  id              String   @id @default(cuid())
  scanRunId       String
  pageId          String
  ruleId          String
  impact          Severity
  description     String
  helpUrl         String?
  wcagTags        String[] @default([])
  selector        String
  elementHtml     String
  elementContext  String?
  screenshotRef   String?
  fingerprint     String
  createdAt       DateTime @default(now())

  scanRun  ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  page     Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  occurrenceLinks FindingOccurrence[]

  @@index([scanRunId])
  @@index([pageId])
  @@index([fingerprint])
  @@index([ruleId])
  @@map("raw_violations")
}

enum EvidenceSource {
  AUTOMATED_AXE
  MANUAL_REVIEW
  IMPORTED
}

enum FindingSourceType {
  CRAWL
  SCAN
  REPO
  PR
  RUNTIME
  MANUAL
  IMPORT
}

enum FindingTargetKind {
  URL
  PAGE
  FLOW
  COMPONENT
  SELECTOR
  FILE
  DESIGN_NODE
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  MITIGATED
  FALSE_POSITIVE
  WONT_FIX
}

enum FindingTruthStatus {
  OPEN
  FIXED_PENDING_VERIFICATION
  VERIFIED_FIXED
  WAIVED
  SUPPRESSED
  INCONCLUSIVE
  STALE
  ERRORED
}

enum RuleEvaluationKind {
  DETERMINISTIC
  HEURISTIC
  MODEL_ASSISTED
}

model CanonicalFinding {
  id              String        @id @default(cuid())
  siteId          String
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sourceType      FindingSourceType @default(SCAN)
  targetKind      FindingTargetKind @default(SELECTOR)
  targetLocator   Json?
  ruleId          String
  normalizedRuleKey String?
  ruleVersion     String?
  evaluationKind  RuleEvaluationKind @default(DETERMINISTIC)
  wcagVersion     String?
  wcagCriteria    String[]      @default([])
  impact          Severity
  confidence      Float         @default(1)
  description     String
  helpUrl         String?
  wcagTags        String[]      @default([])
  fingerprint     String        @unique
  evidenceSource  EvidenceSource @default(AUTOMATED_AXE)
  status          FindingStatus @default(OPEN)
  truthStatus     FindingTruthStatus @default(OPEN)
  firstSeenAt     DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  lastVerifiedAt  DateTime?
  lastScanRunId   String?
  occurrenceCount Int           @default(1)
  /** Distinct completed scan runs where this fingerprint was re-detected (SCAN_RECHECK FAILED). */
  distinctScanRunsObserved Int @default(0)
  /**
   * Distinct completed scan runs where automated verification passed because the fingerprint was absent,
   * while workflow status was still open (not RESOLVED/MITIGATED/FALSE_POSITIVE/WONT_FIX).
   */
  distinctScanRunsAbsentWhenOpen Int @default(0)
  reopenedCount   Int           @default(0)
  statusChangedAt DateTime      @default(now())
  statusChangedById String?
  statusNote      String?
  provenance      Json?
  evidenceSummary Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  occurrences   FindingOccurrence[]
  cluster       IssueCluster?       @relation(fields: [clusterId], references: [id])
  clusterId     String?
  suggestions   RemediationSuggestion[]
  lastScanRun   ScanRun?            @relation(fields: [lastScanRunId], references: [id])
  statusChangedBy User?             @relation("findingStatusChangedBy", fields: [statusChangedById], references: [id])
  statusEvents  FindingStatusEvent[]
  evidenceRecords FindingEvidence[]
  verificationRuns FindingVerificationRun[]
  governanceDecisions FindingGovernanceDecision[]
  comments          FindingComment[]
  aiVisualFindings  AiVisualFinding[]


  @@index([siteId])
  @@index([ruleId])
  @@index([status])
  @@index([truthStatus])
  @@index([impact])
  @@index([clusterId])
  @@index([lastScanRunId])
  @@index([evidenceSource])
  @@index([sourceType])
  @@map("canonical_findings")
}

model FindingOccurrence {
  id                String   @id @default(cuid())
  canonicalFindingId String
  pageId            String
  selector          String
  elementHtml       String
  screenshotRef     String?
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  resolved          Boolean  @default(false)
  lastRawViolationId String?

  finding CanonicalFinding @relation(fields: [canonicalFindingId], references: [id], onDelete: Cascade)
  page    Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  lastRawViolation RawViolation? @relation(fields: [lastRawViolationId], references: [id])

  @@unique([canonicalFindingId, pageId])
  @@index([canonicalFindingId])
  @@index([pageId])
  @@index([lastRawViolationId])
  @@map("finding_occurrences")
}

/// Append-only audit of remediation status transitions (operator workflow).
model FindingStatusEvent {
  id                 String         @id @default(cuid())
  canonicalFindingId String
  fromStatus         FindingStatus?
  toStatus           FindingStatus
  note               String?
  userId             String?
  createdAt          DateTime       @default(now())

  finding CanonicalFinding @relation(fields: [canonicalFindingId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id])

  @@index([canonicalFindingId])
  @@index([createdAt])
  @@map("finding_status_events")
}

// ─── CLUSTERING ──────────────────────────────────────────────

model IssueCluster {
  id              String   @id @default(cuid())
  siteId          String
  name            String
  description     String?
  componentSignature String?
  selectorPattern String?
  domFingerprint  String?
  pageCount       Int      @default(0)
  findingCount    Int      @default(0)
  severity        Severity
  /** Cached impact score (recomputed by ClusterImpact). */
  impactScore     Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  site     Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  findings CanonicalFinding[]
  suggestions RemediationSuggestion[]
  impact   ClusterImpact?

  @@index([siteId])
  @@index([severity])
  @@index([impactScore(sort: Desc)])
  @@map("issue_clusters")
}

// ─── REMEDIATION ─────────────────────────────────────────────

enum SuggestionType {
  ALT_TEXT
  BUTTON_LABEL
  LINK_TEXT
  FORM_LABEL
  HEADING_FIX
  SEMANTIC_HTML
  ARIA_CLEANUP
  COLOR_CONTRAST
  CUSTOM_SNIPPET
}

enum SuggestionStatus {
  DRAFT
  VALIDATED
  FAILED_VALIDATION
  APPROVED
  EXPORTED
  APPLIED
  REJECTED
}

enum RecipeReviewLevel {
  LOW
  MEDIUM
  HIGH
}

model RemediationRecipe {
  id                String            @id @default(cuid())
  organizationId    String?
  ruleId            String
  defectClass       String
  title             String
  applicableTargets String[]          @default([])
  frameworks        String[]          @default([])
  strategy          String
  guidance          String
  verificationSteps String[]          @default([])
  riskNotes         String[]          @default([])
  requiredReviewLevel RecipeReviewLevel @default(MEDIUM)
  confidence        Float             @default(0.5)
  successCount      Int               @default(0)
  rejectionCount    Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  suggestions  RemediationSuggestion[]

  @@unique([organizationId, ruleId, defectClass])
  @@index([organizationId])
  @@index([ruleId])
  @@map("remediation_recipes")
}

model RemediationSuggestion {
  id                String           @id @default(cuid())
  canonicalFindingId String?
  clusterId         String?
  recipeId          String?
  type              SuggestionType
  status            SuggestionStatus @default(DRAFT)
  originalCode      String
  suggestedCode     String
  rationale         String
  confidence        Float            @default(0)
  validationResult  Json?
  appliedBy         String?
  appliedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  finding  CanonicalFinding? @relation(fields: [canonicalFindingId], references: [id])
  cluster  IssueCluster?     @relation(fields: [clusterId], references: [id])
  reviewTask ReviewTask?
  recipe   RemediationRecipe? @relation(fields: [recipeId], references: [id])
  evidenceRecords FindingEvidence[]
  verificationRuns FindingVerificationRun[]

  @@index([canonicalFindingId])
  @@index([clusterId])
  @@index([recipeId])
  @@index([status])
  @@map("remediation_suggestions")
}

// ─── REVIEW ──────────────────────────────────────────────────

enum ReviewType {
  ALT_TEXT_REVIEW
  CONTENT_CLARITY
  KEYBOARD_FLOW
  SCREEN_READER
  SUGGESTION_REVIEW
  MANUAL_AUDIT
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

model ReviewTask {
  id              String       @id @default(cuid())
  suggestionId    String?      @unique
  type            ReviewType
  status          ReviewStatus @default(PENDING)
  title           String
  description     String?
  assigneeId      String?
  notes           String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  suggestion RemediationSuggestion? @relation(fields: [suggestionId], references: [id])
  assignee   User?                  @relation("assignee", fields: [assigneeId], references: [id])
  evidence   EvidenceArtifact[]
  controlPlaneEvidence FindingEvidence[]

  @@index([status])
  @@index([assigneeId])
  @@index([type])
  @@map("review_tasks")
}

model EvidenceArtifact {
  id            String   @id @default(cuid())
  reviewTaskId  String
  type          String
  label         String
  storageKey    String
  metadata      Json?
  createdAt     DateTime @default(now())

  reviewTask ReviewTask @relation(fields: [reviewTaskId], references: [id], onDelete: Cascade)

  @@index([reviewTaskId])
  @@map("evidence_artifacts")
}

enum EvidenceKind {
  SCREENSHOT
  HTML_SNAPSHOT
  DOM_SNIPPET
  SELECTOR_TRACE
  RULE_EVALUATION
  PAGE_METADATA
  VERIFICATION_RESULT
  ERROR_CONTEXT
  REMEDIATION_PROPOSAL
  REVIEWER_NOTE
  GOVERNANCE_NOTE
  AI_VISUAL_REVIEW
}

enum EvidenceLifecycleStatus {
  READY
  MISSING
  FAILED
}

model FindingEvidence {
  id                    String                  @id @default(cuid())
  siteId                String
  canonicalFindingId    String?
  scanRunId             String?
  pageId                String?
  remediationSuggestionId String?
  verificationRunId     String?
  governanceDecisionId  String?
  reviewTaskId          String?
  kind                  EvidenceKind
  lifecycleStatus       EvidenceLifecycleStatus @default(READY)
  label                 String
  summary               String?
  storageKey            String?
  mimeType              String?
  textValue             String?
  jsonValue             Json?
  errorMessage          String?
  metadata              Json?
  capturedAt            DateTime                @default(now())
  createdAt             DateTime                @default(now())

  site       Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  finding    CanonicalFinding?     @relation(fields: [canonicalFindingId], references: [id], onDelete: Cascade)
  scanRun    ScanRun?              @relation(fields: [scanRunId], references: [id], onDelete: SetNull)
  page       Page?                 @relation(fields: [pageId], references: [id], onDelete: SetNull)
  remediationSuggestion RemediationSuggestion? @relation(fields: [remediationSuggestionId], references: [id], onDelete: SetNull)
  verificationRun FindingVerificationRun? @relation(fields: [verificationRunId], references: [id], onDelete: SetNull)
  governanceDecision FindingGovernanceDecision? @relation(fields: [governanceDecisionId], references: [id], onDelete: SetNull)
  reviewTask ReviewTask?           @relation(fields: [reviewTaskId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([canonicalFindingId])
  @@index([scanRunId])
  @@index([pageId])
  @@index([verificationRunId])
  @@index([governanceDecisionId])
  @@index([kind])
  @@map("finding_evidence")
}

enum VerificationKind {
  SCAN_RECHECK
  DOM_ASSERTION
  MANUAL_REVIEW
}

enum VerificationStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  INCONCLUSIVE
  ERRORED
}

model FindingVerificationRun {
  id                    String             @id @default(cuid())
  siteId                String
  canonicalFindingId    String
  scanRunId             String?
  remediationSuggestionId String?
  kind                  VerificationKind   @default(SCAN_RECHECK)
  status                VerificationStatus @default(PENDING)
  triggeredById         String?
  startedAt             DateTime?
  completedAt           DateTime?
  outcomeSummary        String?
  failureReason         String?
  metadata              Json?
  createdAt             DateTime           @default(now())

  site                  Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  finding               CanonicalFinding   @relation(fields: [canonicalFindingId], references: [id], onDelete: Cascade)
  scanRun               ScanRun?           @relation(fields: [scanRunId], references: [id], onDelete: SetNull)
  remediationSuggestion RemediationSuggestion? @relation(fields: [remediationSuggestionId], references: [id], onDelete: SetNull)
  triggeredBy           User?              @relation("verificationTriggeredBy", fields: [triggeredById], references: [id])
  evidence              FindingEvidence[]

  @@index([siteId])
  @@index([canonicalFindingId])
  @@index([scanRunId])
  @@index([status])
  @@map("finding_verification_runs")
}

enum GovernanceDecisionKind {
  WAIVER
  SUPPRESSION
  OVERRIDE
}

enum GovernanceDecisionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model FindingGovernanceDecision {
  id                 String                   @id @default(cuid())
  siteId             String
  canonicalFindingId String
  kind               GovernanceDecisionKind
  status             GovernanceDecisionStatus @default(ACTIVE)
  rationale          String
  justification      String?
  expiresAt          DateTime?
  createdById        String
  approvedById       String?
  revokedById        String?
  approvedAt         DateTime?
  revokedAt          DateTime?
  metadata           Json?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  site       Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  finding    CanonicalFinding @relation(fields: [canonicalFindingId], references: [id], onDelete: Cascade)
  createdBy  User             @relation("governanceCreatedBy", fields: [createdById], references: [id])
  approvedBy User?            @relation("governanceApprovedBy", fields: [approvedById], references: [id])
  revokedBy  User?            @relation("governanceRevokedBy", fields: [revokedById], references: [id])
  evidence   FindingEvidence[]

  @@index([siteId])
  @@index([canonicalFindingId])
  @@index([status])
  @@index([expiresAt])
  @@map("finding_governance_decisions")
}

// ─── INTEGRATIONS ────────────────────────────────────────────

enum IntegrationType {
  GITHUB
  JIRA
  SLACK
  WEBHOOK
}

model IntegrationConnection {
  id             String          @id @default(cuid())
  organizationId String
  type           IntegrationType
  name           String
  config         Json
  encryptedToken String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@map("integration_connections")
}

model GitHubRepoMapping {
  id           String @id @default(cuid())
  siteId       String @unique
  repoOwner    String
  repoName     String
  defaultBranch String @default("main")
  basePath     String @default("/")
  connectionId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("github_repo_mappings")
}

// ─── BILLING ─────────────────────────────────────────────────

model BillingCustomer {
  id             String @id @default(cuid())
  organizationId String @unique
  stripeCustomerId String @unique
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("billing_customers")
}

/// Processed Stripe webhook delivery IDs for idempotency (Stripe retries the same event.id).
model StripeWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

model Subscription {
  id                  String             @id @default(cuid())
  organizationId      String             @unique
  stripeSubscriptionId String?           @unique
  plan                PlanTier           @default(FREE)
  status              SubscriptionStatus @default(ACTIVE)
  maxDomains          Int                @default(1)
  maxPagesPerCrawl    Int                @default(100)
  maxScansPerMonth    Int                @default(5)
  maxSeats            Int                @default(2)
  aiEnabled           Boolean            @default(false)
  aiTokenLimit        Int                @default(0)
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usageRecords UsageRecord[]

  @@map("subscriptions")
}

model UsageRecord {
  id             String   @id @default(cuid())
  subscriptionId String
  metric         String
  quantity       Int
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([metric, periodStart])
  @@map("usage_records")
}

// ─── PLATFORM / INSTALL ───────────────────────────────────────

/// Singleton row: installation marker, worker liveness, optional product flags (non-secret).
model PlatformState {
  id                    String    @id @default("platform")
  installedAt           DateTime  @default(now())
  bootstrapVersion      Int       @default(1)
  workerLastHeartbeatAt DateTime?
  productFlags          Json      @default("{}")

  @@map("platform_state")
}

// ─── AUDIT ───────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model AiUsageLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  model          String
  promptTokens   Int
  completionTokens Int
  totalTokens    Int
  purpose        String
  cost           Float?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ─── MCP API KEYS & BILLING ─────────────────────────────────

model ApiKey {
  id                  String   @id @default(cuid())
  organizationId      String
  keyHash             String   @unique
  name                String
  scopes              Json     @default("[\"*\"]")
  rateLimitPerMinute  Int      @default(60)
  isActive            Boolean  @default(true)
  lastUsedAt          DateTime?
  expiresAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mcpUsageLogs   McpUsageLog[]

  @@index([organizationId])
  @@index([keyHash])
  @@map("api_keys")
}

model McpUsageLog {
  id             String   @id @default(cuid())
  organizationId String
  apiKeyId       String
  toolName       String
  inputTokens    Int
  outputTokens   Int
  totalTokens    Int
  durationMs     Int
  cost           Float
  success        Boolean
  errorMessage   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKey       ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([apiKeyId])
  @@index([toolName])
  @@index([createdAt])
  @@map("mcp_usage_logs")
}

// ─── REPORTS ────────────────────────────────────────────────

model Report {
  id        String   @id @default(cuid())
  siteId    String
  type      String
  title     String
  content   Json
  summary   String?
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("reports")
}

// ─── PUBLIC SCANS (NO-AUTH INSTANT SCANS) ──────────────────

enum PublicScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Anonymous instant scans triggered from the landing page (no account required).
model PublicScanResult {
  id              String           @id @default(cuid())
  domain          String
  url             String
  status          PublicScanStatus @default(PENDING)
  score           Int?
  totalViolations Int              @default(0)
  criticalCount   Int              @default(0)
  seriousCount    Int              @default(0)
  moderateCount   Int              @default(0)
  minorCount      Int              @default(0)
  pagesScanned    Int              @default(0)
  /** Max pages for free tier instant scan. */
  maxPages        Int              @default(5)
  violations      Json?
  /** SHA-256 of IP+domain for abuse prevention. */
  ipHash          String?
  /** Seconds until this result expires and can be re-scanned. */
  rateLimitReset  Int              @default(300)
  screenshotKeys  String[]         @default([])
  createdAt       DateTime         @default(now())
  completedAt     DateTime?
  expiresAt       DateTime?

  @@index([domain])
  @@index([createdAt])
  @@map("public_scan_results")
}

// ─── FIX CREDITS (PAY-PER-FIX) ─────────────────────────────

enum CreditTransactionType {
  PURCHASE
  FIX_APPLIED
  REFUND
  GRANT
  EXPIRY
}

/// Ledger of fix credit purchases, deductions, and refunds.
model FixCredit {
  id             String               @id @default(cuid())
  organizationId String
  type           CreditTransactionType
  amount         Int
  balance        Int
  /** Stripe PaymentIntent ID for purchases. */
  stripePaymentId String?
  /** ID of the remediation suggestion this credit was spent on. */
  suggestionId   String?
  description    String
  metadata       Json?
  createdAt      DateTime             @default(now())
  expiresAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@map("fix_credits")
}

// ─── CLUSTER IMPACT PROJECTION ─────────────────────────────

/// Cached impact scores for issue clusters (recomputed after each scan).
model ClusterImpact {
  id              String   @id @default(cuid())
  clusterId       String   @unique
  impactScore     Float
  estimatedTraffic BigInt  @default(0)
  pagesAffected   Int      @default(0)
  severityWeight  Float    @default(1)
  /** Pareto rank: 1 = highest impact fix. */
  paretoRank      Int?
  /** Percentage of total site issues this cluster represents. */
  issuePercentage Float    @default(0)
  /** Estimated hours to fix manually. */
  estimatedHours  Float?
  /** Estimated cost to fix manually (hours * avg dev rate). */
  estimatedCost   Float?
  computedAt      DateTime @default(now())

  cluster IssueCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([impactScore(sort: Desc)])
  @@index([paretoRank])
  @@map("cluster_impacts")
}

// ─── COLLABORATIVE REVIEW COMMENTS ─────────────────────────

/// Threaded comments on findings for team collaboration.
model FindingComment {
  id                String   @id @default(cuid())
  canonicalFindingId String
  userId            String
  organizationId    String
  body              String
  parentId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  finding      CanonicalFinding @relation(fields: [canonicalFindingId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       FindingComment?  @relation("commentThread", fields: [parentId], references: [id])
  replies      FindingComment[] @relation("commentThread")

  @@index([canonicalFindingId])
  @@index([organizationId])
  @@index([userId])
  @@index([parentId])
  @@map("finding_comments")
}

// ─── WEBHOOK TRIGGERS (SELF-HEALING) ───────────────────────

enum WebhookSource {
  VERCEL
  NETLIFY
  GITHUB_DEPLOY
  CUSTOM
}

/// Registered deploy webhooks that trigger automatic post-deploy scans.
model DeployWebhook {
  id             String       @id @default(cuid())
  siteId         String
  organizationId String
  source         WebhookSource
  /** Shared secret for verifying webhook signatures. */
  secret         String
  isActive       Boolean      @default(true)
  /** Only trigger scans for these branches (empty = all). */
  branches       String[]     @default([])
  /** Slack/email notification channel for regression alerts. */
  notifyChannel  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([organizationId])
  @@map("deploy_webhooks")
}

// ─── FIX CREDIT BALANCE (MATERIALIZED VIEW) ────────────────

/// Denormalized running balance per organization for fast lookups.
model FixCreditBalance {
  organizationId String   @id
  balance        Int      @default(0)
  totalPurchased Int      @default(0)
  totalSpent     Int      @default(0)
  totalRefunded  Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("fix_credit_balances")
}

// ─── AI VISUAL REVIEW ──────────────────────────────────────

enum VisualReviewStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Tracks a batch AI visual review run for a site/scan.
model AiVisualReviewRun {
  id                    String           @id @default(cuid())
  scanRunId             String
  siteId                String
  status                VisualReviewStatus @default(PENDING)
  pagesReviewed         Int              @default(0)
  totalFindings         Int              @default(0)
  highConfidenceFindings Int             @default(0)
  humanReviewRequired   Int              @default(0)
  totalCostUsd          Float            @default(0)
  totalLatencyMs        Int              @default(0)
  startedAt             DateTime?
  completedAt           DateTime?
  errorMessage          String?
  createdAt             DateTime         @default(now())

  scanRun  ScanRun            @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  site     Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  findings AiVisualFinding[]

  @@index([scanRunId])
  @@index([siteId])
  @@index([status])
  @@map("ai_visual_review_runs")
}

/// Individual finding from AI visual review (vision, keyboard, screen reader).
model AiVisualFinding {
  id                String   @id @default(cuid())
  reviewRunId       String
  siteId            String
  pageId            String
  criterionId       String
  criterionName     String
  level             String
  status            String
  confidence        Float
  severity          String
  description       String
  selector          String?
  suggestedFix      String?
  source            String   @default("vision")
  action            String   @default("evidence_only")
  /** Links to CanonicalFinding if one was auto-created. */
  canonicalFindingId String?
  reviewEvidenceId  String?
  metadata          Json?
  createdAt         DateTime @default(now())

  reviewRun        AiVisualReviewRun  @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  site             Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  page             Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  canonicalFinding CanonicalFinding?  @relation(fields: [canonicalFindingId], references: [id])

  @@index([reviewRunId])
  @@index([siteId])
  @@index([pageId])
  @@index([criterionId])
  @@index([confidence])
  @@index([action])
  @@map("ai_visual_findings")
}
