    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@aros/config": "*",
    "@aros/core-services": "*",
    "@aros/db": "*",
    "@aros/shared": "*",
    "@aros/stakeholders": "*",
    "autoprefixer": "^10.4.0",
    "bullmq": "^5.31.0",
    "clsx": "^2.1.0",
    "ioredis": "^5.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^18.5.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@ducanh2912/next-pwa": "^10.2.6",
