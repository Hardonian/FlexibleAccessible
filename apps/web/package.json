{
  "name": "@aros/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node ./scripts/generate-pwa-icons.mjs",
    "icons": "node ./scripts/generate-pwa-icons.mjs",
    "dev": "npm run icons && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
